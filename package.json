{
  "name": "find-remote-for-me",
  "version": "0.1.0",
  "private": true,
  "description": "Private remote job discovery dashboard for a Luxembourg-based senior frontend/full-stack engineer.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24 <26",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm run design:tokens && tsx watch --clear-screen=false server.ts",
    "build": "pnpm run design:tokens && next build",
    "start": "pnpm run design:tokens && NODE_ENV=production tsx server.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:api": "vitest run tests/api",
    "test:e2e": "bddgen test && playwright test",
    "test:storybook": "storybook build --quiet",
    "test": "pnpm run test:unit && pnpm run test:integration && pnpm run test:api && pnpm run test:storybook",
    "storybook": "pnpm run design:tokens && storybook dev -p 6006",
    "build-storybook": "pnpm run design:tokens && storybook build",
    "generate:component": "plop component",
    "generate:server-module": "plop server-module",
    "generate:feature": "plop feature",
    "design:tokens": "tsx scripts/generate-design-tokens.ts"
  },
  "dependencies": {
    "@ariakit/react": "^0.4.43",
    "class-variance-authority": "^0.7.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/nextjs-vite": "^10.6.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.4.6",
    "jsdom": "^30.0.1",
    "msw": "^2.13.6",
    "playwright": "^1.65.0",
    "playwright-bdd": "^9.2.1",
    "plop": "^4.0.5",
    "storybook": "^10.6.7",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.3",
    "wait-on": "^9.5.1"
  }
}
